# .env.example

# Database
# PostgreSQL connection string format: 
# postgresql://username:password@host:port/database
# get a free database at https://neon.tech
DATABASE_URL=your_database_url_here

# Trefle API (optional - enables plant image fetching)
# get your API key from https://trefle.io/
TREFLE_API_KEY=your_trefle_api_key_here

# Secret
SESSION_SECRET=your_session_secret_here

# Admin
ADMIN_PASSWORD=your_admin_password_here

# these are set automatically by the setup script
# check the terminal output after running setup to verify
GUEST_USER_ID=1
ADMIN_USER_ID=2