<!-- src/views/partials/plant-card.ejs -->

<div class="plant-card card-sm"
    data-common="<%= plant.common_name %>" 
    data-scientific="<%= plant.scientific_name %>"
    data-quantity="<%= quantityToSortValue(plant.quantity_level) %>"
    data-created="<%= plant.created_at %>"
    data-updated="<%= plant.updated_at %>">

  <a href="/plants/<%- plant.id %>" class="card-link">

  <div class="card-img-sm-wrapper">
    <% if (plant.image_url) { %>
      <img src="<%= plant.image_url %>" class="card-img img-sm">
    <% } else { %>
      <div class="card-img-placeholder-sm">
        <i class="fa-solid fa-seedling"></i>
      </div>
    <% } %>
  </div>

    <p class="plant-name-sm">
      <strong class="common-name-sm"><%= plant.common_name %></strong>
      <em class="scientific-name-sm"><%= plant.scientific_name %></em>
    </p>
    <div class="plant-status status-sm">
      <div class="stock badge badge-sm badge-<%= plant.stock_status.toLowerCase().replace(/\s+/g, '-') %>">
        <% if (plant.stock_status === 'in_stock') { %>
          <i class="fa-regular fa-circle-check"></i> <%= formatStockStatus(plant.stock_status) %>
        <% } else if (plant.stock_status === 'out_of_stock') { %>
          <i class="fa-regular fa-circle-xmark"></i> <%= formatStockStatus(plant.stock_status) %>
        <% } else { %>
          <i class="fa-regular fa-circle-question"></i> <%= formatStockStatus(plant.stock_status) %>
        <% } %>
      </div>

      <% if (plant.quantity_level === 'low') { %>
        <div class="quantity badge badge-sm badge-low">
          <i class="fa-solid fa-chevron-down"></i> <%= formatQuantityLevel(plant.quantity_level) %>
        </div>
      <% } else if (plant.quantity_level === 'medium') { %>
        <div class="quantity badge badge-sm badge-medium">
          <i class="fa-solid fa-angle-up"></i> <%= formatQuantityLevel(plant.quantity_level) %>
        </div>
      <% } else if (plant.quantity_level === 'high') { %>
        <div class="quantity badge badge-sm badge-high">
          <i class="fa-solid fa-angles-up"></i> <%= formatQuantityLevel(plant.quantity_level) %>
        </div>
      <% } %>

        <% if (plant.order_status === 'on_order') { %>
        <div class="order badge badge-sm badge-on_order">
          <i class="fa-solid fa-envelope-circle-check"></i> <%= formatStockStatus(plant.order_status) %>
        </div>
      <% } else if (plant.order_status === 'needs_ordering') { %>
        <div class="order badge badge-sm badge-needs_ordering">
          <i class="fa-solid fa-envelope"></i> <%= formatStockStatus(plant.order_status) %>
        </div>
      <% } %>


    </div>
  </a>
</div>