<!-- src/views/login.ejs -->

<!DOCTYPE html>
<html lang="en" class="custom-scrollbar">
    <%- include("./partials/head.ejs") %>
    <body>
        <h1><%= title %></h1>
        <!-- display validation errors -->
            <% if (error) { %>
                <p class="error"><%= error %></p>
            <% } %>
        <div class="login content">
            <div class="form-container-wrapper">
                <form action="/auth/login" method="POST" class="form-container">
                    <div class="form-row">
                        <div class="form-col">
                            <label for="password">Password</label>
                            <input 
                                type="password" 
                                name="password" 
                                id="password" 
                                required>
                        </div>
                    </div>
    
                    <div class="form-row">
                        <div class="form-col">
                            <button type="submit" class="button submit alt-submit">Login</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <%- include("../partials/footer.ejs") %>
    </body>
</html>